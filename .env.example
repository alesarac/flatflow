# ========================================================
# FlatLoop — Variabili d'ambiente di configurazione (.env.local)
# ========================================================

# 1. Codice segreto condiviso della casa (richiesto per l'accesso dei coinquilini)
# Obbligatorio: imposta una stringa sicura conosciuta solo dai tre coinquilini
HOUSE_SECRET_CODE=<INSERISCI_CODICE_SEGRETO_DELLA_CASA>

# 2. Chiave segreta per la firma sicura della sessione (HMAC-SHA256)
# Obbligatorio: deve essere una stringa casuale di almeno 32 caratteri
SESSION_SECRET=<INSERISCI_CHIAVE_SEGRETA_ALMENO_32_CARATTERI_CASUALI>

# 3. Supabase Database (obbligatorio in produzione su Vercel)
# Reperibili dalla dashboard del tuo progetto su https://supabase.com (Project Settings -> API o API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<TUO-PROGETTO-ID>.supabase.co
# Secret API Key (con prefisso sb_secret_...) oppure la chiave legacy service_role
# NOTA: Questa chiave opera con privilegi elevati sul DB: conservala solo sul server e NON esporla nel client.
SUPABASE_SECRET_KEY=<LA_TUA_SECRET_API_KEY_sb_secret_O_SERVICE_ROLE_KEY>

# 4. Impostazioni opzionali per test / sviluppo isolato
# Per consentire l'uso del database locale solo durante i test:
# USE_LOCAL_DB=true

# 5. Connessione diretta PostgreSQL (opzionale, per lo script locale di reset scripts/reset-db.ps1)
# Reperibile su Supabase in Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres.[ID_PROGETTO]:[PASSWORD]@aws-0-[REGIONE].pooler.supabase.com:6543/postgres
