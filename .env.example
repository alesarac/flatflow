# ========================================================
# Flatflow — Variabili d'ambiente (.env.local)
# ========================================================

# 1. Codice segreto condiviso della casa (richiesto per l'accesso dei coinquilini)
HOUSE_SECRET_CODE=flatflow2026

# 2. Chiave segreta per la firma sicura della sessione (HMAC-SHA256)
SESSION_SECRET=flatflow-chiave-segreta-di-sessione-cambiala-in-produzione

# 3. Supabase (opzionale in locale con fallback su file data/local-db.json, raccomandato in produzione su Vercel)
# Ottenibili dal pannello del tuo progetto su https://supabase.com (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=la-tua-service-role-key-di-supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-public-key-di-supabase
